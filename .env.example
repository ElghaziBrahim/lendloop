# LendLoop environment template for the Next.js app.
#
# `npx convex dev` and Clerk's keyless mode write most of these values to
# .env.local for you. Use this file as the complete reference, or copy it if
# you are filling every value by hand.
#
# .env.local is gitignored. Never commit a filled copy.
#
# Convex deployment variables are a separate environment. They are not read
# from this file: set them with `npx convex env set NAME value` (see README).

# ---------------------------------------------------------------------------
# Clerk
# ---------------------------------------------------------------------------

# With no keys, the first `npm run dev` starts Clerk keyless mode, provisions
# a development application and writes both values below to .env.local.
# Claim the application from the URL it prints so the keys keep working.
# The publishable key is public; the secret key is server only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends the user. These are optional: the routes exist either way.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Convex
# ---------------------------------------------------------------------------

# Written by `npx convex dev`.
# CONVEX_DEPLOYMENT selects the deployment for the CLI.
# NEXT_PUBLIC_CONVEX_URL is the deployment's HTTP API, used by the browser.
# NEXT_PUBLIC_CONVEX_SITE_URL is the origin of its HTTP actions; n8n calls
#   https://<deployment>.convex.site/n8n/overdue and /n8n/reminder-result.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# Local tooling only
# ---------------------------------------------------------------------------

# Used by scripts/mock-n8n-receiver.mjs to verify the outbound signature, and
# as the value to set on the Convex deployment and in n8n. The Next.js app
# itself never reads it. Generate with: openssl rand -hex 32
N8N_HMAC_SECRET=

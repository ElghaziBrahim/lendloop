# n8n environment for LendLoop, used by docker-compose.yml.
#
#   cp n8n/.env.example .env      # fill in the values, never commit .env
#   docker compose up -d          # http://localhost:5678
#
# This file is for n8n only. The Next.js app reads .env.local instead; see the
# root .env.example and the README's environment table.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Encrypts n8n's own credential store. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# The HMAC secret shared with Convex (set the same value as N8N_HMAC_SECRET in
# .env.local on the Convex deployment). Generate with: openssl rand -hex 32
N8N_HMAC_SECRET=

# Convex HTTP site that n8n calls: https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Address the notification emails are sent from. Must be a verified sender on
# the Resend account behind the "Resend API key" credential.
LENDLOOP_FROM_EMAIL="LendLoop <notifications@example.com>"

# Where the error workflow sends its alert.
LENDLOOP_ALERT_EMAIL=admin@example.com

# Host and public URL n8n advertises. Behind a tunnel or proxy, set these to the
# public https URL so webhook URLs and execution links resolve.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# The Resend API key is NOT set here: it lives in n8n as a header-auth
# credential named "Resend API key" (Authorization: Bearer re_...), created
# once per instance and referenced by id from the workflow JSON.
